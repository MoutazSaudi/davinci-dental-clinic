# Local database (matches docker-compose.yml). Replace with your hosted DB URL later.
DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic?schema=public"

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Session length in seconds (default 86400 = 24h)
AUTH_SESSION_MAX_AGE_SECONDS=86400
# Development only: set to "false" to skip login. Ignored in production (login is always required).
AUTH_ENABLED=true

# Used only by `pnpm db:seed` to create the first admin user
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="1234567890"
GA_PROPERTY_ID=562068191
