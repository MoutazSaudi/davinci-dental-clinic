# Local database (matches docker-compose.yml). Replace with your hosted DB URL later.
DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic?schema=public"

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Session length in seconds (default 86400 = 24h)
AUTH_SESSION_MAX_AGE_SECONDS=86400
# Development only: set to "false" to skip login. Ignored in production (login is always required).
AUTH_ENABLED=true

# Required at production runtime: absolute path on persistent storage, outside release directories.
# The app creates this directory recursively; its nearest existing parent must be writable.
# Example on a provisioned server/volume: /var/lib/davinci/uploads/videos
# Development defaults to <project>/uploads/videos. See docs/video-storage.md.
VIDEO_UPLOAD_DIR=""

# Used only by `pnpm db:seed` to create the first admin user
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="1234567890"
GA_PROPERTY_ID=562068191
GOOGLE_CLIENT_EMAIL=davinci-analytics-reader@davinci-dental-analytics.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=""

# Appointment email reminders (Resend; verified sender/domain required)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Signing secret for /api/webhooks/resend (whsec_...)
RESEND_WEBHOOK_SECRET=""
# Random secret used by the five-minute scheduler; never NEXT_PUBLIC
CRON_SECRET=""
